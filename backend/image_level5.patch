+# Image Level 5 (21 Nov 2026): a house style trained from 10-60 of the owner's pictures (a Qwen-Image LoRA made by the
+# style-trainer Serverless endpoint, serverless/style-trainer), and overnight batches of up to 2,000 pictures.
+STYLE_LORA=re.compile(r'^ecco-style-[a-f0-9]{32}\.safetensors$')
+def style_loras():
+    return {r['lora'] for r in records('style_training') if r.get('status')=='ready' and STYLE_LORA.match(str(r.get('lora','')))}
+def _runpod():
+    try:return __import__('runpod_client')
+    except ImportError:return None
+def trainer_ready():
+    rp=_runpod();return bool(rp and rp.configured('trainer'))
+def create_style_training(body):
+    items=body.get('items')
+    if not isinstance(items,list) or not 10<=len(items)<=60:raise Problem('Choose 10 to 60 pictures to teach the style (20 to 50 works best)')
+    ids=[i.get('asset_id') if isinstance(i,dict) else None for i in items]
+    if len(set(ids))!=len(ids):raise Problem('Each picture can be used once')
+    pictures=[]
+    for item in items:
+        a=get(str(item.get('asset_id','')),'asset')
+        if a.get('media')!='image' or a.get('deleted'):raise Problem('Choose pictures outside Trash')
+        pictures.append((a,text(item.get('caption') or 'a picture',400)))
+    name=text(body.get('name'),80);trigger=re.sub(r'[^a-z0-9]','',str(body.get('trigger') or 'eccostyle').lower())[:24] or 'eccostyle'
+    steps=number(body.get('steps',1200),200,4000,True)
+    record=save(new('style_training',name=name,trigger=trigger,asset_ids=[a['id'] for a,_ in pictures],steps=steps,status='queued',progress='Waiting for the style trainer',lora=None,story_id=body.get('story_id')))
+    if not trainer_ready():
+        record.update(status='needs_trainer',progress='The style trainer is not connected yet. The pictures and captions are saved; training starts once it is set up.');save(record)
+        return record
+    def train():
+        import io,tarfile
+        rp=_runpod();buffer=io.BytesIO()
+        with tarfile.open(fileobj=buffer,mode='w') as tar:
+            for i,(a,caption) in enumerate(pictures):
+                src=asset_path(a);tar.add(str(src),arcname=f'{i:03d}{src.suffix.lower() or ".png"}')
+                data=(trigger+', '+caption).encode();info=tarfile.TarInfo(f'{i:03d}.txt');info.size=len(data);tar.addfile(info,io.BytesIO(data))
+        staged=Path(rp.VOLUME)/'ecco-serverless'/'inputs'/f'style-{record["id"]}.tar';staged.parent.mkdir(parents=True,exist_ok=True);staged.write_bytes(buffer.getvalue())
+        def update(**kw):
+            current=get(record['id'],'style_training');current.update(kw);save(current)
+        try:
+            update(status='running',progress='Starting the style trainer')
+            job=rp.submit('trainer',{'key':record['id'],'name':'ecco-style-'+record['id'],'steps':steps,'dataset':{'volume_key':f'ecco-serverless/inputs/style-{record["id"]}.tar'}})
+            update(runpod_job=job)
+            out=rp.wait('trainer',job,timeout=6*3600,on_progress=lambda t:update(progress=str(t)[:200]))
+            if out.get('error'):raise Problem(out['error'])
+            if not STYLE_LORA.match(str(out.get('lora',''))):raise Problem('The trainer returned no style file')
+            update(status='ready',lora=out['lora'],progress='Ready',finished=time.time())
+        except Exception as exc:
+            update(status='failed',progress='Training stopped',error=str(getattr(exc,'message',exc))[:500])
+        finally:staged.unlink(missing_ok=True)
+    threading.Thread(target=train,daemon=True).start()
+    return record
