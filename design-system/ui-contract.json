      "ariaSelected",
      "ariaDisabled",
      "errorAnnouncement"
    ],
    "usage": [
      "screens",
      "selectors",
      "instances",
      "exceptions",
      "approval",
      "implementationStatus"
    ]
  },
  "sharedRules": {
    "labelColor": "yellow (existing accent)",
    "defaultControlText": "white",
    "selectedControlText": "yellow (existing accent)",
    "connectedIndicator": "yellow",
    "disconnectedIndicator": "white",
    "errorText": "red",
    "popupClose": {
      "glyph": "\u00d7",
      "placement": "upper right",
      "background": "yellow",
      "behavior": "Close only the owning popup; preserve parent popup"
    },
    "newObjects": "Register component type and properties, reuse existing component rules, regenerate inventory in the same change.",
    "numericValues": "Do not invent sizes or silently normalize existing differences. Record actual declarations and obtain approval for changed standards."
  },
