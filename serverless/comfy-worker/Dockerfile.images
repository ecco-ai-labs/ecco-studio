# Image "creating" endpoint (ecco-images): Qwen-Image-2512, Studio's default, is baked in with its text
# encoder and VAE (~30 GB), so a cold worker loads it from local disk. Other image models (SDXL, FLUX.2,
# Z-Image) are still read from the global volume (/runpod-volume). Qwen Image Edit has its own endpoint
# (Dockerfile.images-edit); without it, edits run here and load from the volume.
# Build context: repository root.
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
ENV PYTHONUNBUFFERED=1 COMFY_DIR=/comfyui ZIMAGE_DIR=/runpod-volume/ecco-models/z-image

# Models first, one file per step (each build step must finish in 30 min), so code changes below
# reuse these layers when the builder has them cached.
COPY serverless/comfy-worker/bake.sh /opt/bake.sh
RUN pip install --no-cache-dir "huggingface_hub[hf_xet]>=0.34"
RUN bash /opt/bake.sh Comfy-Org/Qwen-Image_ComfyUI split_files/vae/qwen_image_vae.safetensors vae
RUN bash /opt/bake.sh Comfy-Org/Qwen-Image_ComfyUI split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors text_encoders
RUN bash /opt/bake.sh Comfy-Org/Qwen-Image_ComfyUI split_files/diffusion_models/qwen_image_2512_fp8_e4m3fn.safetensors diffusion_models \
    5dc80554d5d83390046a2f4a94ece06afb7700bf7b0aaf8bde9769793875876b

ENV HF_HUB_OFFLINE=1
COPY serverless/worker_common.py serverless/comfy-worker/ /opt/ecco/
RUN bash /opt/ecco/build.sh images
CMD ["python", "-u", "/opt/ecco/handler.py"]
