# Video endpoint: Wan 2.2 TI2V 5B and Wan 2.2 I2V A14B.
# Build context: repository root.
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
ENV PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 COMFY_DIR=/comfyui
COPY serverless/weights-url.txt serverless/download_weights.py serverless/worker_common.py serverless/comfy-worker/ /opt/ecco/
RUN bash /opt/ecco/build.sh video
CMD ["python", "-u", "/opt/ecco/handler.py"]
